{
  "name": "@barth/sylius-gemini-local-translate-plugin",
  "version": "0.0.1",
  "private": true,
  "symfony": {
    "controllers": {
      "gemini-translate": {
        "main": "controllers/gemini_translate_controller.js",
        "fetch": "lazy",
        "enabled": true
      }
    }
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@symfony/stimulus-bridge": "^3.2.0",
    "@symfony/webpack-encore": "^4.7.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "devDependencies": {
    "jasmine": "^5.1.0"
  },
  "scripts": {
    "dev": "encore dev --config webpack.config.js",
    "build": "encore production --config webpack.config.js",
    "test": "jasmine"
  }
